{
  "$schema": "https://opencode.ai/config.json",
  "providers": {
    "llamacpp": {
      "name": "llamacpp",
      "package": "@opencode-ai/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://llamacpp/v1",
        "apiKey": "apiKey"
      },
      "models": {
        "modelname": {
          "name": "modelname",
          "limits": {
            "context": 100000
          }
        }
      }
    }
  },
  "model": "llamacpp/modelname",
  "plugins":  [
    {
      "package": "./manual_plugins/tencentdb-agent-memory/tencentdb/index.ts",

      "options": {
        "gateway": {
          "url": "http://127.0.0.1:8420",
          "apiKey": "{file:~/.config/opencode/secrets/tdai-gateway-key}"
        },

        "memory": {
          "instanceId": "default",
          "teamId": "team-",
          "userId": "usr-",

          "defaultAgentId": "agt-",

          "agents": {
            "osho": "",
            "kyosha": "",
            "kinsho": "",
            "keima": "",
            "kakugyo": "",
            "hisha": "",
            "ginsho": "",
            "fuhyo": ""
          }
        },

        "knowledge": {
          "url": "http://127.0.0.1:8424/v3",

          "discovery": {
            "enabled": true,
            "cacheSeconds": 60,
            "maxAssetsPerKind": 4
          },

          "defaultWikiIds": [],
          "defaultCodeGraphIds": [],

          "agents": {
            "build": {
              "wikiIds": [],
              "codeGraphIds": []
            }
          }
        },

        "retrieval": {
          "budgetPerTurn": 3,
          "memoryLimit": 5,
          "knowledgeLimit": 10,
          "scenarioIndexLimit": 20
        },

        "dream": {
          "enabled": true,
          "pathPrefix": "Dreams",
          "maxCommitChars": 8000,

          "sample": {
            "atomicPool": 12,
            "conversationPool": 8,
            "atoms": 3,
            "conversations": 2,
            "scenarios": 1,
            "includeCore": true,
            "sourceMaxChars": 1400,
            "scenarioMaxChars": 2200,
            "coreMaxChars": 2200
          }
        },

        "guardrails": {
          "enabled": true,
          "blockPublicWebOnPersonalMemory": true,

          "outputLanguage": "English",

          "annotateTencentEvidence": true
        },

        "exposeAdminTools": false,
        "traceFile": "/tmp/tencentdb-opencode.log",

        "timeouts": {
          "gatewayMs": 5000,
          "captureMs": 10000,
          "knowledgeMs": 10000
        },

        "circuit": {
          "failureThreshold": 5,
          "openSeconds": 60
        }
      }
    }
  ]
}
