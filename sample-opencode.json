{
  "$schema": "https://opencode.ai/config.json",
  "providers": {
    "llamacpp": {
      "name": "llamacpp",
      "package": "@opencode-ai/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://192.168.1.148:4242/v1",
        "apiKey": "otsumi"
      },
      "models": {
        "otsumi": {
          "name": "otsumi",
          "limits": {
            "context": 100000
          }
        },
        "otsumi-rp": {
          "name": "otsumi-rp",
          "limits": {
            "context": 100000
          }
        }
      }
    }
  },
  "model": "llamacpp/otsumi",
  "default_agent": "osho",
  "experimental": {
    "subagent_depth": 2
  },
  "plugins":  [
    { "package": "./plugins/mode-router-v2", "options": { "enabled": true } },
    {
      "package": "./plugins/response-gadgets-v2",
      "options": {
        "enabled": true
      }
    },
    {
      "package": "./manual_plugins/tencentdb-agent-memory/tencentdb/index.ts",

      "options": {
        "gateway": {
          "url": "http://127.0.0.1:8420",
          "apiKey": "{file:~/.config/opencode/secrets/tdai-gateway-key}"
        },

        "memory": {
          "instanceId": "default",
          "teamId": "team-",
          "userId": "usr-",

          "agents": {
            "osho": "TENCENT_AGENT_ID_OSHO",
            "kyosha": "TENCENT_AGENT_ID_KYOSHA",
            "kinsho": "TENCENT_AGENT_ID_KINSHO",
            "keima": "TENCENT_AGENT_ID_KEIMA",
            "kakugyo": "TENCENT_AGENT_ID_KAKUGYO",
            "hisha": "TENCENT_AGENT_ID_HISHA",
            "ginsho": "TENCENT_AGENT_ID_GINSHO",
            "fuhyo": "TENCENT_AGENT_ID_FUHYO"
          }
        },

        "knowledge": {
          "url": "http://127.0.0.1:8424/v3",

          "discovery": {
            "enabled": true,
            "cacheSeconds": 60,
            "maxAssetsPerKind": 4
          },

          "defaultWikiIds": [],
          "defaultCodeGraphIds": [],

          "agents": {}
        },

        "retrieval": {
          "budgetPerTurn": 3,
          "memoryLimit": 5,
          "knowledgeLimit": 10,
          "scenarioIndexLimit": 20
        },

        "dream": {
          "enabled": true,
          "pathPrefix": "Dreams",
          "maxCommitChars": 8000,

          "sample": {
            "atomicPool": 12,
            "conversationPool": 8,
            "atoms": 3,
            "conversations": 2,
            "scenarios": 1,
            "includeCore": true,
            "sourceMaxChars": 1400,
            "scenarioMaxChars": 2200,
            "coreMaxChars": 2200
          }
        },

        "guardrails": {
          "enabled": true,
          "blockPublicWebOnPersonalMemory": true,

          "outputLanguage": "user-language",

          "annotateTencentEvidence": true
        },

        "exposeAdminTools": false,
        "traceFile": "/tmp/tencentdb-opencode-v4.log",

        "timeouts": {
          "gatewayMs": 5000,
          "captureMs": 10000,
          "knowledgeMs": 10000
        },

        "circuit": {
          "failureThreshold": 5,
          "openSeconds": 60
        }
      }
    }
  ]
}
